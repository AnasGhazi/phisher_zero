# Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/

GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use (optional, defaults to gemini-1.5-flash)
# Other options: gemini-2.5-flash, gemini-pro, etc.
GEMINI_MODEL=gemini-1.5-flash

# Test Automation Configuration (optional)

# Email request delay in seconds between API calls (default: 0.5)
# Increase this to reduce rate limiting pressure (e.g., 5 or 10)
EMAIL_REQUEST_DELAY=0.5

# Use mock agent instead of real Gemini API (default: 0)
# Set to 1 to run offline tests without consuming quota
USE_MOCK_AGENT=0

# Quota fallback threshold (default: 2)
# Number of consecutive quota errors before automatically switching to mock agent
QUOTA_FALLBACK_THRESHOLD=2

# Prompt template to use (default: EMAIL_WORKFLOW_PROMPT)
# Options: EMAIL_WORKFLOW_PROMPT or PROMPT
PROMPT_NAME=EMAIL_WORKFLOW_PROMPT
